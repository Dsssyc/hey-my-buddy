#!/bin/sh
# The shared skill's POSIX command entry. Daily calls use the active Python.
set -eu
BUDDY_SKILL_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -f "$BUDDY_SKILL_DIR/package/pyproject.toml" ]; then
  BUDDY_PROJECT_DIR="$BUDDY_SKILL_DIR/package"
else
  BUDDY_PROJECT_DIR=$(CDPATH= cd -- "$BUDDY_SKILL_DIR/../.." && pwd)
fi
export BUDDY_SKILL_DIR
case "${1:-}" in
  install|upgrade)
    exec "${UV_BIN:-uv}" run --frozen --python 3.12 --project "$BUDDY_PROJECT_DIR" python "$BUDDY_PROJECT_DIR/src/hey_my_buddy/install/launcher.py" "$@"
    ;;
esac
if [ "${BUDDY_DEV_SOURCE:-}" = 1 ]; then
  exec "${UV_BIN:-uv}" run --frozen --python 3.12 --project "$BUDDY_PROJECT_DIR" python "$BUDDY_PROJECT_DIR/src/hey_my_buddy/install/launcher.py" "$@"
fi
if [ -z "${BUDDY_BOOTSTRAP_PYTHON:-}" ] && [ -f "$BUDDY_SKILL_DIR/.runtime-python" ]; then
  IFS= read -r BUDDY_BOOTSTRAP_PYTHON < "$BUDDY_SKILL_DIR/.runtime-python"
fi
if ! command -v "${BUDDY_BOOTSTRAP_PYTHON:-python3}" >/dev/null 2>&1; then
  printf '%s\n' '{"contractVersion":"unknown","error":{"code":"ACTIVE_RUNTIME_UNAVAILABLE","message":"Run the fixed-version package install command to repair the runtime interpreter"}}'
  exit 1
fi
exec "${BUDDY_BOOTSTRAP_PYTHON:-python3}" "$BUDDY_PROJECT_DIR/src/hey_my_buddy/install/launcher.py" "$@"
