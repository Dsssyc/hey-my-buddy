#!/bin/sh
# The hey-my-buddy CLI, shipped inside the shared `buddy` skill.
#
# An installed skill carries its uv project in `package/` next to this script's
# directory; a source checkout keeps the project at the repository root two levels
# above `skills/buddy`. The project is resolved from this file's own location, never
# from the caller's cwd, and every argument is forwarded verbatim:
#
#   ~/.agents/skills/buddy/scripts/buddy health
#   ~/.agents/skills/buddy/scripts/buddy submit '<controlled task JSON>'
set -eu
BUDDY_SKILL_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -f "$BUDDY_SKILL_DIR/package/pyproject.toml" ]; then
  BUDDY_PROJECT_DIR="$BUDDY_SKILL_DIR/package"
else
  BUDDY_PROJECT_DIR=$(CDPATH= cd -- "$BUDDY_SKILL_DIR/../.." && pwd)
fi
PATH="${HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${PATH:-/usr/bin:/bin}"
export PATH BUDDY_SKILL_DIR
exec "${UV_BIN:-uv}" run --frozen --python 3.12 --project "$BUDDY_PROJECT_DIR" python "$BUDDY_PROJECT_DIR/src/buddy/launcher.py" "$@"
